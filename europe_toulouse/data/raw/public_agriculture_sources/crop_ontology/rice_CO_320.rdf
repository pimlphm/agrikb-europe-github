        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000201"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001218">
    <ns1:definition xml:lang="en">Measure the width of the second elongated internode from the base at the narrower portion of the stem with the leaf sheath. Repeat the measurement on other representative plant. Take the average diameter.</ns1:definition>
