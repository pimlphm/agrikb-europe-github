      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000334">
    <rdfs:label xml:lang="en">Stigma exsertion calculation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N23c975b8fd274a02b0c60703936b6199">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000093"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count the number of florets that have completed anthesis on a given day and the number of those florets that have exserted stigma on one or both sides of the floret. Calculate the proportion of florets with exserted stigma</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000267">
    <rdfs:subClassOf>
