    <ns4:entity>Grassy stunt 2</ns4:entity>
    <ns1:definition xml:lang="en">The type and severity of grassy stunt symptoms caused by the grassy stunt 2 virus (RGSV2). Symptoms: severe stunting, excessive tillering, yellow to orange and narrow leaves with small rusty spots</ns1:definition>
    <rdfs:label xml:lang="en">Grassy stunt 2 disease</rdfs:label>
    <ns4:attribute>Severity</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
