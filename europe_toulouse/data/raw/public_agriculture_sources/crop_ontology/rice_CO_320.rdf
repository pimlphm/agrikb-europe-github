    <ns1:definition xml:lang="en">Estimate presence/absence of knees after flowering in conditions where culms have fallen flat due to receding water flow.</ns1:definition>
    <rdfs:label xml:lang="en">Kneeing ability presence</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001285">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">About 2 weeks after flowering, measure grain weight twice at a week interval. Then, compute the grain filling rate by dividing the difference in weight by the time interval. Eg grain weight at 21 days after flowering minus grain weight at 15 days after flowering divided by six days</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na68a64ab0b314fdab05aa36e52a2fa1f">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001155"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Calculation - Grain filling rate</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000031">
    <ns1:definition xml:lang="en">Angle of inclination of the base of the main culm from vertical</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <rdfs:label xml:lang="en">Culm angle</rdfs:label>
    <ns4:attribute>Angle</ns4:attribute>
    <ns4:entity>Culm</ns4:entity>
    <ns4:acronym xml:lang="en">CulmAng</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000382">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N71eb3dd4c75849f399d292d4395c14c4">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000199"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Gall midge injury assessment field</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">In a field test, observe the proportion of infected tillers. For the field test to be considered a valid measure of resistance, more than 60% of the plants of the susceptible check should be affected with not less than 15% silver shoot</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001177">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1401670fa209407d8d62b7b40b8b0ad5">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001071"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Take the number of days to flowering and add 30 days</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Calculation - Days to maturity</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000222">
    <ns1:definition xml:lang="en">Measure the average length of the sterile lemmas of five spikelets. If the two sterile lemmas on each spikelet differ in length, measure only the shorter one.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5c17f7773db74803b134f73ee9cb9b84">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000042"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf74f132d8d9b4278bf2cc37287ed4b31">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000042"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Average sterile lemma length - shorter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001145">
    <ns4:acronym xml:lang="en">StLIG</ns4:acronym>
    <ns1:definition xml:lang="en">Total lignin content in the stem</ns1:definition>
    <ns4:attribute>Lignin content</ns4:attribute>
    <rdfs:label xml:lang="en">Stem total lignin content</rdfs:label>
    <ns4:entity>Stem</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000421">
    <rdfs:label xml:lang="en">secondary panicle branching scale</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N498f8f418e6942b5a68bfaea008687ef">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000420"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000773">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N8cff582a64a14a2a963855af16b91cca">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000506"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Lemma phenol reaction</rdfs:label>
    <ns1:definition xml:lang="en">Place hulls from 10 grains into a petri dish of 5 cm diameter, add 5 ml of 1.5% phenol solution, cover the petri dish, and keep at room temperature for 1 day. Observe the intensity of the reaction of the phnol on the lemmas</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000534">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ncc2a33ca60e04093b0210a0e524d9bc5">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000489"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe the presence and intensity of any purplish colour that can be attributed to anthocyanin on the outer surface of the basal leaf sheath</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne9ef6e24f9ee4c3ba24b10b716d0a335">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000489"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Basal leaf sheath anthocyanin presence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000193">
    <ns1:definition xml:lang="en">The type and severity of hoja blanca disease symptoms caused by rice hoja blanca virus (RHBV) causing hoja blanca. Symptoms: cream colored to yellow spots, elongating and coalescing fo form longitudinal yellowish green to pale green striations. Streaks may coalesce to cover the whole leaf. Brown and sterile glumes with typical parrot beak shape of deformation</ns1:definition>
    <ns4:attribute>Severity</ns4:attribute>
    <ns4:entity>Hoja blanca</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <rdfs:label xml:lang="en">Hoja blanca disease</rdfs:label>
    <ns4:acronym xml:lang="en">HojaBlancaSev</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000610">
    <rdfs:label xml:lang="en">rice delphacid injury scale field</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9a4955901a4d4238b47eee4c5545a0bf">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000798"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000091">
    <ns4:acronym xml:lang="en">MaleSterGp</ns4:acronym>
    <ns4:entity>Male pollen</ns4:entity>
    <ns4:attribute>Sterility cause</ns4:attribute>
    <ns1:definition xml:lang="en">A classification of male sterility according to the type or cause of sterility</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Fertility"/>
    <rdfs:label xml:lang="en">Male sterility group</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000439">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc605b50349474907a2b7637e4150e9fb">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000100"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Weigh a random sample of 1000 well-developed, whole grains dried to 14% moisture content</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">1000 grain (14%MC)weight measurement</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001073">
    <ns4:attribute>Yield</ns4:attribute>
    <ns4:entity>Aboveground dry matter</ns4:entity>
    <rdfs:label xml:lang="en">Dry matter yield</rdfs:label>
    <ns4:acronym xml:lang="en">TDM</ns4:acronym>
    <ns1:definition xml:lang="en">Dry weight of all aboveground biomass per area</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000181">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:attribute>Damage</ns4:attribute>
    <rdfs:label xml:lang="en">Leaf scald damage</rdfs:label>
    <ns4:entity>Leaf scald</ns4:entity>
    <ns1:definition xml:lang="en">The type and severity of leaf scald symptoms on leaves caused by the fungal pathogen Monographella albescens (Microdochium oryzae). Symptoms: lesions occur mostly near leaf tips, but sometimes start at the margin of the blade and develop into large ellipsoid areas encircled by dark-brown, narrow bands accompanied by a light-brown halo</ns1:definition>
    <ns4:acronym xml:lang="en">LfScald</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001132">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <rdfs:label xml:lang="en">Time to maturity (from sowing)</rdfs:label>
    <ns4:attribute>Time to maturity from sowing</ns4:attribute>
    <ns4:acronym xml:lang="en">DMatS</ns4:acronym>
    <ns1:definition xml:lang="en">Time elapsed from date of sowing to physiological maturity stage</ns1:definition>
    <ns4:entity>Spikelet</ns4:entity>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001126">
    <ns4:entity>Dehulled grain after milling</ns4:entity>
    <ns4:acronym xml:lang="en">BRR</ns4:acronym>
    <rdfs:label xml:lang="en">Brown rice rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:attribute>Proportion</ns4:attribute>
    <ns1:definition xml:lang="en">Proportion of brown rice (dehulled grains) obtained from rough rice (hulled grain)</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000942">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf1052354aac94f2cb908f716ea828cec">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000539"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:label xml:lang="en">brown planthopper biotype 3 injury scale</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000510">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:entity>Panicle blast</ns4:entity>
    <ns4:attribute>Damage</ns4:attribute>
    <rdfs:label xml:lang="en">Panicle blast damage</rdfs:label>
    <ns1:definition xml:lang="en">The type and severity of panicle blast symptoms caused by the fungal pathogen Magnaporthe grisea (Pyricularia oryzae). Symptoms: Dark, necrotic lesions cover partially or completely around the panicle base (node) or the uppermost internode or the lower part pf panicle axis. The panicles are greyish and have either partially filled or unfilled grains</ns1:definition>
    <ns4:acronym xml:lang="en">PBDam</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000173">
    <ns4:entity>Bacterial blight</ns4:entity>
    <rdfs:label xml:lang="en">Bacterial blight damage</rdfs:label>
    <ns1:definition xml:lang="en">The type and severity of bacterial blight symptoms on leaves caused by the bacterial pathogen Xanthomonas oryzae pv. oryzae. Symptoms: lesions usually start near the leaf tip or leaf margins or both, and extend down the outer edge(s). Young lesions are pale green to grayish green, later turning yellow to gray (dead) with time. In very susceptible varieties, lesions may extend to the entire leaf length into the leaf sheath</ns1:definition>
    <ns4:acronym xml:lang="en">BBDam</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:attribute>Damage</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001368">
    <rdfs:label xml:lang="en">drought grade 1-5</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1bab057a20f14188903cb64aae7ac60f">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001235"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000511">
    <ns4:entity>Panicle blast</ns4:entity>
    <ns1:definition xml:lang="en">The type and severity of panicle blast symptoms caused by the fungal pathogen Magnaporthe grisea (Pyricularia oryzae). Symptoms: Dark, necrotic lesions cover partially or completely around the panicle base (node) or the uppermost internode or the lower part pf panicle axis. The panicles are greyish and have either partially filled or unfilled grains</ns1:definition>
    <ns4:acronym xml:lang="en">PBSev</ns4:acronym>
    <rdfs:label xml:lang="en">Panicle blast severity</rdfs:label>
    <ns4:attribute>Severity</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000107">
    <ns4:acronym xml:lang="en">GelTemp</ns4:acronym>
    <ns4:entity>Milled caryopsis</ns4:entity>
    <ns1:definition xml:lang="en">Temperature at which the starch in endosperm gelatinizes, one of the key indicators of cooking quality</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:attribute>Gelatinization temperature</ns4:attribute>
    <rdfs:label xml:lang="en">Gelatinization temperature</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000795">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6dee36191a5f417989e7c3e2a05f2f55">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000183"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Estimate the type and severity of symptoms</ns1:definition>
    <rdfs:label xml:lang="en">Ragged stunt disease estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000108">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:entity>Head rice</ns4:entity>
    <ns4:attribute>Proportion</ns4:attribute>
    <ns1:definition xml:lang="en">Describes how much of a sample of milled rice comprises whole rather than broken kernels. Head rice is defined as kernels longer than 8/10th of the average length of whole kernels</ns1:definition>
    <ns4:acronym xml:lang="en">HdR</ns4:acronym>
    <rdfs:label xml:lang="en">Head rice</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000760">
    <ns1:definition xml:lang="en">Examine the colour of the keel of immature lemmas and evaluate the intensity of any purple colour attributable to anthocyanin</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2f3235e9796b4fcbb701a9e760f1336d">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000501"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Keel anthocyanin immature examination</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001203">
    <rdfs:label xml:lang="en">Image analysis - Pith area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N256cc9739bdf4b6da5c1219b1e23a163">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001092"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">View cross-sectioned samples of second internode under stereo microscope and use Image J software to measure the area of the hollow region of the culm</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001120">
    <ns4:entity>Spikelet</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns4:attribute>Time to flowering from emergence</ns4:attribute>
    <rdfs:label xml:lang="en">Time to flowering (from emergence)</rdfs:label>
    <ns4:acronym xml:lang="en">DFlwE</ns4:acronym>
    <ns1:definition xml:lang="en">Time elapsed from date of emergence to flowering stage</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000600">
    <rdfs:label xml:lang="en">panicle exsertion male sterile scale</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
