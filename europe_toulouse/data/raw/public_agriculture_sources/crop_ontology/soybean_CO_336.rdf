        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_336:0000219"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Elliptic Fourier descriptor measures 5 components, including aspect ratio of leaflet shape, location of centroid of leaflets along midrib, straightness or distortion of leaflet shape, and roundness of leaflet shape. Measured on central leaflets of fully expanded leaflets. Can also be measured as the ratio of leaflet width to leaflet length from upper third of plant.</ns1:definition>
    <rdfs:label xml:lang="en">Leaf shape method</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_336:0000148">
    <ns1:definition xml:lang="en">Measure the weight of lysine extracted from the seed sample and divide by the weight of protein extracted from the same sample.</ns1:definition>
