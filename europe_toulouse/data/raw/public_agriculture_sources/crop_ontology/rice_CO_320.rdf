      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001166">
    <ns1:definition xml:lang="en">View cross-sectioned samples of second internode under stereo microscope and use Image J software to measure the width of the wider portion of the culm</ns1:definition>
    <rdfs:label xml:lang="en">Image analysis - Major culm diameter</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2ceda28c5b114488922e7a4988175194">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001051"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
