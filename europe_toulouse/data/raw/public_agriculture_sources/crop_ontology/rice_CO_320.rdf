    <rdfs:label xml:lang="en">Panicle branch arrangement</rdfs:label>
    <ns1:definition xml:lang="en">The arrangement of primary branches on the panicle axis, grouped into whorls or individually on alternate sides</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001148">
