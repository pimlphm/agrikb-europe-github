      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000799">
    <rdfs:label xml:lang="en">Salt injury assessment</rdfs:label>
