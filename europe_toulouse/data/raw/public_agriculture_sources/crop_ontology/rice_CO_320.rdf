  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000179">
    <ns4:entity>Grassy stunt 1</ns4:entity>
    <ns1:definition xml:lang="en">The type and severity of grassy stunt symptoms caused by the grassy stunt 1 virus (RGSV1). Symptoms: severe stunting, excessive tillering, pale green to yellow and narrow leaves with small rusty spots</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <rdfs:label xml:lang="en">Grassy stunt 1 disease</rdfs:label>
