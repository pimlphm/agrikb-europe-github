  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000757">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Green leafhopper injury assessment field</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nbc32bcaadf3348179a6da84a3dee2db1">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000200"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe the damage on the seedlings caused by green leafhopper. For a field test, use an augmented experimental design with a susceptible check replicated at intervals across the whole trial. The test is considered a valid test for resistance if the hopper population is uniformly distributed at a high level across the screening box, as indicated by hopper counts on the susceptible check. A minimum of the following hopper density on susceptible check is necessary: a. 10 hoppers/hill at 10-15 days after transplanting, b. 25 hoppers / hiII at maximum tillering, c. 100 hoppers/hill at early booting stage</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000766">
