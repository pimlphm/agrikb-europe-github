      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">SDFZGD - Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000139">
    <rdfs:label xml:lang="en">SCF - AFIS Measurement</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N8158b1999a474ca0b1af81ea5d9b8712">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000138"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Seed coat fragments (SCFs) are the parts of a seed coat that have been broken from the surface of either mature or immature seeds during mechanical processing measured by AFIS</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000796">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
