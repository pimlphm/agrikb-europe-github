      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Derive grain weight per plant from number of productive panicles per plant, 1000-grain weight, and number filled spikelets per panicle.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
