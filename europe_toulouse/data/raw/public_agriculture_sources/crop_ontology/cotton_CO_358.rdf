    <rdfs:label xml:lang="en">DTL - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Trichome density on abaxial side of leaf is visually rated using scale of 1 (smooth), 3 (lightly hairy), 5 (hairy), 7(very hairy), and 9 (pilose) for six leaves per plot</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000370">
    <ns1:definition xml:lang="en">Drought tolerance is the degree to which a plant is adapted to arid or drought conditions</ns1:definition>
