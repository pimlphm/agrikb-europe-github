  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001156">
    <ns4:entity>Panicle</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns1:definition xml:lang="en">Panicle dry weight per plant</ns1:definition>
