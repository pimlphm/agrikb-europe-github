# Copy this file to .env on each new computer.
# Do not put real API keys into git, screenshots, or public zip packages.

# Kimi / Moonshot is the default answer backend. Ollama is only a manual fallback.
KNOWLEDGE_RAG_BACKEND=kimi_cli
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Kimi Code plan OpenAI-compatible backend.
# For Kimi Code membership keys that start with sk-kimi-, use the coding endpoint below.
# For Kimi Open Platform pay-as-you-go keys, use https://api.moonshot.cn/v1 and a platform model such as kimi-k2.5.
KNOWLEDGE_RAG_BASE_URL=https://api.kimi.com/coding/v1
KNOWLEDGE_RAG_MODEL=kimi-for-coding
# KNOWLEDGE_RAG_API_KEY=
# Kimi CLI reads KIMI_API_KEY. Keep it equal to KNOWLEDGE_RAG_API_KEY for coding-plan keys.
# KIMI_API_KEY=
# MOONSHOT_API_KEY=
AGRIKB_FRONTEND_BASE_URL=https://api.kimi.com/coding/v1
AGRIKB_FRONTEND_MODEL=kimi-for-coding
# AGRIKB_FRONTEND_KIMI_API_KEY=
AGRIKB_KIMI_TIMEOUT=180
AGRIKB_KIMI_MAX_RETRIES=1

# Keep this false for Kimi unless you have a separate embedding model endpoint.
# The project still performs fast local BM25 + local vector retrieval when this is false.
KNOWLEDGE_RAG_REMOTE_EMBEDDINGS=false
# KNOWLEDGE_RAG_EMBEDDING_MODEL=

KNOWLEDGE_RAG_HOST=127.0.0.1
KNOWLEDGE_RAG_PORT=8010
AGRIKB_KIMI_CACHE=true
AGRIKB_FAST_MODE=true
