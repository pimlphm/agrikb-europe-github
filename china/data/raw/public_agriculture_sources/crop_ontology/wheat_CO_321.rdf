    <ns4:acronym xml:lang="en">GFP</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns1:definition xml:lang="en">Time period between anthesis (ds65) and maturity (ds87).</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000164">
    <ns4:entity>Plant</ns4:entity>
    <ns1:definition xml:lang="en">Plants killed as a result of winter conditions.</ns1:definition>
