  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000808">
    <rdfs:label xml:lang="en">Whitebacked planthopper injury assessment field</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf700cde40c9b4499ad309030b98c3fb9">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000211"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe the damages on plants caused by whitebacked planthopper. For a field test, use an augmented experimental design with a susceptible check replicated at intervals across the whole trial. The test is considered a valid test for resistance if the hopper population is uniformly distributed at a high level across the screening box, as indicated by hopper counts on the susceptible check. A minimum of the following hopper density on susceptible check is necessary: a. 10 hoppers/hill at 10-15 days after transplanting, b. 25 hoppers / hiII at maximum tillering, c. 100 hoppers/hill at early booting stage</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000592">
