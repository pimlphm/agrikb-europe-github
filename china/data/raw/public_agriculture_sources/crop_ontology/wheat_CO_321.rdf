  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001530">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">The number of infertile spikelets (i.e., those NOT containing grain) per spike should be counted towards the end of grain-filling, but before physiological maturity (to avoid losses due to movement through the plots). Randomly sample 5-10 spikes per plot, by selecting at the base of the culm. Count the total number of spikelets (pair-by-pair, from the base to the tip), then obtain the average.</ns1:definition>
    <rdfs:label xml:lang="en">InfertSpkN Counting</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf45864951fe64949a8a048d305801324">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0001484"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
