    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">millimeter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001216">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N3371be089c6e4faa9854236947b961c7">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001104"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Calculation - Stem diameter</rdfs:label>
    <ns1:definition xml:lang="en">Take the average of major and minor stem diameters of the second elongated internode from the base</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000951">
