  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001692">
    <rdfs:label xml:lang="en">GPD Computation</rdfs:label>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Computation">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Method"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculated as the deviation from the yield-protein linear regression.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf790f98d239f411c8a5ff02f4c7d9b28">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0001672"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000231">
    <rdfs:label xml:lang="en">Hd DS55 days Computation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N87790ec3ec62461bb0393f3ee1db4f49">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000007"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Number of days required from sowing to spike emergence from the flag leaf (DS55). However, when planting in dry soils in dryland areas it is counted from the first day of rainfall or irrigation which is sufficient for germination, or from emergence date.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000037">
    <rdfs:label xml:lang="en">Grain color</rdfs:label>
    <ns1:definition xml:lang="en">Grain color.</ns1:definition>
    <ns4:entity>Grain</ns4:entity>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Quality">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Trait"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns4:attribute>Color</ns4:attribute>
    <ns4:acronym xml:lang="en">GCol</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001031">
    <ns4:acronym xml:lang="en">MgrisSev</ns4:acronym>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Biotic_stress">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Trait"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns4:entity>Spike</ns4:entity>
    <ns1:definition xml:lang="en">Wheat blast severity in the spikes caused by the agent Magnaporthe grisea (Pyricularia oryzae). Symptoms: It can infect all above-ground parts of the wheat plant, but head blast, resembling Fusarium head blight in appearance, is the most common symptom in the field. Infected spikes become bleached and produce small shriveled seed or none at all.</ns1:definition>
    <rdfs:label xml:lang="en">Wheat blast severity</rdfs:label>
    <ns4:attribute>Wheat blast severity</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000348">
    <rdfs:label xml:lang="en">StomaSiz  Measurement</rdfs:label>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Measurement">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Method"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Standard method for stomatal size.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N89d5955bfb1f4692b684cb6167c4c7cd">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000142"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
