  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000329">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne19b7be113d6414ab3b9e31e7eb08e63">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000113"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">PthornDmg Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Above-ground symptoms of root lesion nematodes are often indistinct and difficult to identify, but include poor vigor, stunted growth, poor tillering, and wilting in response to moisture stress. Often, crop growth in an infected field will be irregular or patchy. Below ground, cereal roots will display generalized root browning, with lesions rapidly coalescing to produce extensive areas of discoloration. Lesions are only readily observed on the roots in the very early stages of infection. Lateral roots will be reduced in both length and number, and the root system may be thin and poorly branched or appear necrotic.</ns1:definition>
  </ns2:Class>
  <ns2:ObjectProperty rdf:about="https://cropontology.org/rdf/variable_of">
    <rdfs:label>variable_of</rdfs:label>
  </ns2:ObjectProperty>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001583">
    <rdfs:label xml:lang="en">Seedling rust field response Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9c27f5ccaca945a58a8b990d9977885e">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0001527"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Seedling host responses are normally scored as susceptible or resistant depending on the infection type produced with a designated isolate in a particular environment. The infection type produced will often change if the environment is altered.</ns1:definition>
  </ns2:Class>
