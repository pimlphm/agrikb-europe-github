    <ns4:entity>Leaf</ns4:entity>
    <ns4:attribute>Length</ns4:attribute>
    <ns1:definition xml:lang="en">Length of penultimate leaf blade</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000176">
    <ns4:acronym xml:lang="en">LfBlastDam</ns4:acronym>
    <rdfs:label xml:lang="en">Leaf blast damage</rdfs:label>
    <ns1:definition xml:lang="en">The type and severity of leaf blast symptoms on leaves caused by the fungal pathogen Magnaporthe grisea (Pyricularia oryzae). Symptoms are necrotic lesions on the leaves, in severe cases leading to leaf death</ns1:definition>
    <ns4:entity>Leaf blast</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:attribute>Damage</ns4:attribute>
  </ns2:Class>
