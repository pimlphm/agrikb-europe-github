      <ns2:Restriction rdf:nodeID="Ndf80499761cc44d4b0174733400ca4be">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000021"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5c7304b107754a378476104662d6fbbb">
