    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc6dcbdb4fa5d4d2eac1990f2a6a71a06">
