  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000199">
    <ns4:acronym xml:lang="en">NWI2</ns4:acronym>
    <ns1:definition xml:lang="en">Normalized water index 2 is used track changes in rwc, leaf water potential, stomatal conductance, and foliage minus air temperature differences when plant water stress is well developed (rwc&lt;0.85).</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns4:entity>Canopy</ns4:entity>
    <rdfs:label xml:lang="en">Canopy normalized water index 2</rdfs:label>
    <ns4:attribute>Normalized water index 2</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000883">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N728727281128493493ff4fb92c752490">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000909"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Severity of rust in spike is recorded as a percentage, according to the modified Cobb scale. As this relies upon observation it cannot be absolutely accurate. Thus it is common to use the following intervals: 0, 5, 10, 20, 40, 60, and 100 percent infection.</ns1:definition>
    <rdfs:label xml:lang="en">PstriSpkSev Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000258">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nb07cb12c1e4943449f89e78f9d279941">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000038"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">The number of grains per spike can be measured independently by threshing a known number of randomly selected spikes per plot (10-20 spikes per plot) or can be calculated as: Grains per spike (GSP) = grains m2 / spikes m2.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">GrnSpk Computation</rdfs:label>
  </ns2:Class>
