    <rdfs:label xml:lang="en">Calculation - Days to physiological maturity from sowing</rdfs:label>
    <ns1:definition xml:lang="en">Calculate the number of days between sowing and physiological maturity (i.e. when the grain is hard and ready for harvest)</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nb2de33ee710f4f14aedc7baa08d900e9">
