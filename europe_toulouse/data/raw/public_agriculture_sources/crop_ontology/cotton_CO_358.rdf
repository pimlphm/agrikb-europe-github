    <rdfs:label xml:lang="en">Stem color</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000049">
    <ns1:definition xml:lang="en">The total sulfur (S) concentration measured in a given volume of a plant or a plant part or plant extract</ns1:definition>
    <ns4:attribute>Sulfur concentration</ns4:attribute>
    <ns4:acronym xml:lang="en">SCONC</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <rdfs:label xml:lang="en">Sulfur concentration</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000217">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N0a8a270b906e42259c65b7a7210a2554">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000216"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
