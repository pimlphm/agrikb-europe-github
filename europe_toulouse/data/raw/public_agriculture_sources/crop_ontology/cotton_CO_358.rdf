    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Verticillium wilt severity (or disease infection index) is calculated according to the formula: DI=[Ʃ(Ni × i)/(N × i)] × 100, Where i is the maximum disease grade, Ni, the number of plants with corresponding disease grade and N the number of total investigated plants</ns1:definition>
    <rdfs:label xml:lang="en">VWDS - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
