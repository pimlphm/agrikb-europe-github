  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000755">
    <rdfs:label xml:lang="en">Grassy stunt 2 disease index</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Grow plants in a greenhouse. Inoculate seedlings. Score RGSV2Sev_Est_1to9 after 5 weeks, and calculate Disease Index DI= (20xN3 + 40xN5 + 70xN7 + 100xN9)/NT, where N3-N9 are the number of plants with score 3-9 and NT is total number of plants scored</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N0216c8c1d8d041b39777314212431a28">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000500"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000769">
    <ns1:definition xml:lang="en">Wild species: assess the presence/absence of hairs on the leaf margin</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nba517562cfe74aaaa65639dffc37e3b2">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000504"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Leaf margin pubescence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000042">
    <ns4:acronym xml:lang="en">StrLmLng</ns4:acronym>
    <ns1:definition xml:lang="en">Length of sterile lemmas</ns1:definition>
