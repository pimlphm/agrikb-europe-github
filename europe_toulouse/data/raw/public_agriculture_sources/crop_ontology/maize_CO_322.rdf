    <ns4:entity>Ear</ns4:entity>
    <rdfs:label xml:lang="en">Ear aspect</rdfs:label>
    <ns1:definition xml:lang="en">Observation of harvested ears based on some morphological and agronomical characters such as ear size, total numbers of ear harvested per plot, ear damaged caused by insects or/and diseases.</ns1:definition>
