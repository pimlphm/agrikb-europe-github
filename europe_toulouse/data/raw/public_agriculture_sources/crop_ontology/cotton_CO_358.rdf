    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">1-6 low-high DTS scale</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000693">
    <rdfs:label xml:lang="en">SOC - Estimation</rdfs:label>
    <rdfs:subClassOf>
