  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_334:0010280">
    <ns1:definition xml:lang="en">Visual rating of root symptoms caused by cassava brown streak virus at twelve months after planting, in the family of Potyviridae and genus Ipomovirus. Symptoms rated from 1=(clean,no infection) to 5=(extremely severe, severely diseased)</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nc04f990da75f42e2a56ea42d6496c276">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_334:0000090"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
