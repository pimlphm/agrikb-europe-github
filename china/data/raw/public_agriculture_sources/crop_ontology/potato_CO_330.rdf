    <ns2:entity>Boiled potato</ns2:entity>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_330:0001208">
    <rdfs:label xml:lang="en">ultraperformance liquid chromatography with masa spectrometry-epicatechindry weight</rdfs:label>
