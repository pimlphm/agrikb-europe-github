        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000034"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
