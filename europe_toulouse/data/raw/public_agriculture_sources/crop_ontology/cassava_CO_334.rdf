    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_334:0010429">
    <rdfs:label xml:lang="en">Visual Rating:root evaluation_method</rdfs:label>
    <ns1:definition xml:lang="en">An evaluation of the integration of root shape, size, diameter, constriction, neck length on a scale. Before scoring the roots, the field technician walks the harvested plot to get an idea of the average root type of the trial which will then be used as the middle level of the scale. Genotypes better than average will be scored with scale levels lower than the middle level. Similiar genotype that are certainly worse compared to the average score are rated with levels higher than the middle level. Trait description is provided by Hernan Ceballos of CIAT</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N7fb2691ec74049039b79ce586a7c059c">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_334:0000448"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
