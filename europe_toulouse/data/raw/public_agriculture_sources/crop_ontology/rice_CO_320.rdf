  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001284">
    <ns1:definition xml:lang="en">Dry aboveground plant parts, excluding panicles. Weigh and take the average weight per plant</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Average - Straw yield</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N20ae5916fcd34ef2a86f0e8679a44f37">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
