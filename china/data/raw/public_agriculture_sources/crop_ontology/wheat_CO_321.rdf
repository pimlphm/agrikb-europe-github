        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0001489"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">TTIB Computation</rdfs:label>
  </ns2:Class>
