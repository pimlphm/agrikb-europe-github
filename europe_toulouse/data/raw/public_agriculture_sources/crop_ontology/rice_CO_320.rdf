        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001074"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Average - Number of elongated internodes</rdfs:label>
    <ns1:definition xml:lang="en">Count number of elongated internodes starting from the base of the main culm to the neck node</ns1:definition>
