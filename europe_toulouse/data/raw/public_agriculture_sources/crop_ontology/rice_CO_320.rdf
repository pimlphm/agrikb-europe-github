  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001051">
    <rdfs:label xml:lang="en">Culm major diameter - 2nd internode</rdfs:label>
    <ns1:definition xml:lang="en">Major diameter (ie the longest diameter of an eliptical section) of the wider portion of the second elongated internode from the base without the leaf sheath</ns1:definition>
    <ns4:attribute>Major diameter</ns4:attribute>
    <ns4:entity>2nd elongated culm internode</ns4:entity>
    <ns4:acronym xml:lang="en">CDMaj</ns4:acronym>
