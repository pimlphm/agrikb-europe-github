    <rdfs:label xml:lang="en">SCY - Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000029">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns4:acronym xml:lang="en">PetSpt</ns4:acronym>
    <ns1:definition xml:lang="en">Red coloration at base of flower petals, creating the effect of a spot in the center of the flower</ns1:definition>
    <ns4:attribute>Spot</ns4:attribute>
    <rdfs:label xml:lang="en">Petal spot</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000138">
    <rdfs:label xml:lang="en">Seed coat fragment</rdfs:label>
    <ns4:acronym xml:lang="en">SCF</ns4:acronym>
    <ns4:attribute>Fragment</ns4:attribute>
    <ns1:definition xml:lang="en">Seed coat fragments (SCFs) are the parts of a seed coat that have been broken from the surface of either mature or immature seeds during mechanical processing</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000812">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N200a5cc781b947bb80a1439ca400248a">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000811"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">In the Regional test the standard skein strength of the yarn in millinewtons per tex(mN/tex) is estimated from miniature skeins. The data are adjusted to standard skein basis and corrected to 27 tex</ns1:definition>
    <rdfs:label xml:lang="en">YS - Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
