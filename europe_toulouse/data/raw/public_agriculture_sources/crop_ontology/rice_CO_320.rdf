        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001215">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ncb47e7c0629b4f098389382ad1d2b20f">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001103"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Calculation - Stay-green</rdfs:label>
    <ns1:definition xml:lang="en">Take the ratio of number of green leaves at maturity to the number of green leaves at flowering</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
