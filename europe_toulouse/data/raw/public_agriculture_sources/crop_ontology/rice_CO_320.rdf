  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001137">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <rdfs:label xml:lang="en">Half-filled spikelets proportion</rdfs:label>
    <ns4:acronym xml:lang="en">HFSpPct</ns4:acronym>
    <ns4:entity>Half-filled spikelet</ns4:entity>
    <ns1:definition xml:lang="en">Proportion of spikelets on a harvested panicle that are half-filled</ns1:definition>
    <ns4:attribute>Proportion</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001213">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Calculation - Spikelets per square meter</rdfs:label>
    <ns1:definition xml:lang="en">Calculate as the sum of filled, half-filled and unfilled spikelets per area</ns1:definition>
