  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000235">
    <rdfs:label xml:lang="en">Average leaf width</rdfs:label>
    <ns1:definition xml:lang="en">Measure width at the widest portion of the penultimate leaf on the main culm of five representative plants. Calculate average</ns1:definition>
