  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000515">
    <ns1:definition xml:lang="en">The type and severity of yellow dwarf symptoms caused by a mycoplasma. Symptoms: pale yellow, droopy leaves, excessive tillering and stunting</ns1:definition>
    <rdfs:label xml:lang="en">Yellow dwarf</rdfs:label>
