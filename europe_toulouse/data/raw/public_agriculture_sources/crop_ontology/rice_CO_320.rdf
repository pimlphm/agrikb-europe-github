    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000058">
    <ns4:entity>Drought</ns4:entity>
    <ns1:definition xml:lang="en">The extent to which plants recover when soaked with water after exposure to drought. The extent of recovery depends strongly on the severity of drought.</ns1:definition>
    <ns4:attribute>Recovery</ns4:attribute>
    <ns4:acronym xml:lang="en">DhtRecov</ns4:acronym>
