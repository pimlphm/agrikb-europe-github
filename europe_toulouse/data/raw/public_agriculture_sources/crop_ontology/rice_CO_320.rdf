      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001234">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nee5ed5a15e0d41bfb9e214baa49914f3">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001118"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Take youngest fully expanded leaf (penultimate leaf) and measure leaf temperature with the portable photosynthesis system (LCPro+ ADC)</ns1:definition>
    <rdfs:label xml:lang="en">Manual measurement - Leaf surface temperature in SITIS platform</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001254">
    <rdfs:label xml:lang="en">Calculation - Grain yield per plant</rdfs:label>
