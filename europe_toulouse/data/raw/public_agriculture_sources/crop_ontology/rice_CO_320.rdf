    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:label xml:lang="en">mature lemma and palea color scale SES</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001242">
    <rdfs:label xml:lang="en">NRGQASC - Grain thickness</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc9e8f846879b4ce59b69b3b687565daa">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000020"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Manually measured according to the National Rice Grain Quality Assessment Standard of China (GB/T17891-1999)</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000800">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Cook freshly harvested grains and smell the aroma</ns1:definition>
