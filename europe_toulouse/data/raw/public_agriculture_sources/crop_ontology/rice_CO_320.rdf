    <rdfs:label xml:lang="en">cm</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000262">
