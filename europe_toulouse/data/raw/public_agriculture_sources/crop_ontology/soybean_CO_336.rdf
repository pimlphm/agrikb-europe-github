  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_336:0000220">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N086b5556cca640a2a14730643f986dac">
