  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000891">
    <rdfs:label xml:lang="en">BOLLPIT - Estimantion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Intensity of the pitting of the surface of the mature, but non cleft bolls. </ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N10350248ecd641039253e2c092c267ff">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000229"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000873">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">FWDS - Estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N498b8dbbcead4463a78f2d3f57f40e01">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000839"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Disease severty index of vascular root stain in a field infested with Fusarium oxysporum f. sp. vasinfectum race 1 and root-knot nematodes.  Vascular Root Staining: 0 = no vascular root staining evident, 1 = light vascular root staining evident as spotty areas, 2 = more continuous than 1, but light colored staining  covering an area between one quarter and one half of the stem cross-section, 3 = moderate brown/black staining evident in a band encircling most of the stem cross section, 4 = brown/black staining evident across most vascular tissue in stem cross section, and 5 = plant severely damaged or plant death with staining evident throughout a cross-section of root tissue</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000862">
    <rdfs:label xml:lang="en">FLWSC - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Average plot flowering response approximately 3 weeks post Summer Solstice. Code description: no squares=no sign of flowering response in the plot; squares=flower buds are formed in the plot; flowers=flowers are opening, but bolls are not yet formed; bolls=bolls are developing on the plants; open bolls=already maturing</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N56e367a02f674085b782bf5f541f5595">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000031"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000436">
