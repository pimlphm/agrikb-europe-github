      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Calculation - Days to 50% flowering from sowing</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001092">
    <ns4:acronym xml:lang="en">PithA</ns4:acronym>
