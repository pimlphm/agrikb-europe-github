    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns1:definition xml:lang="en">Calculated by dividing fruit branch length by fruit branch nodes</ns1:definition>
    <ns4:attribute>Internode length</ns4:attribute>
    <ns4:acronym xml:lang="en">FBNDL</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000093">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nb56eb0ed772040e18284bb2bc8f6ffdc">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000014"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">QS-2-1-4-3 - Computation</rdfs:label>
    <ns1:definition xml:lang="en">Fiber quality score calculated by weighting selected fiber traits as follows: fiber length (0.2), mic (0.1), UI (0.4), and strength (0.3)</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000709">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nb9dc63d8e5944cafbd99fd940cfb2458">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000030"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Standard method for the total phosphorus (P) concentration measured in a given volume of stem extract</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">PCONC - Measurement</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000996">
    <rdfs:label xml:lang="en">VWDS - Computation</rdfs:label>
    <ns1:definition xml:lang="en">Verticillium wilt severity (or disease infection index) is calculated in seedling stage. the formula is: DI=[Ʃ(Ni × i)/(N × i)] × 100, Where i is the maximum disease grade, Ni, the number of plants with corresponding disease grade and N the number of total investigated plants</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ndd21eb25643243649e881ee21b8194d9">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000001"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000297">
    <ns1:definition xml:lang="en">Verticillium wilt incidence on is calculated in flowering stage, as the ratio between the number of infected plants and the total number of plants. OR: Disease incidence = No. of infected plants x 100 Total no. of plant assessed</ns1:definition>
    <rdfs:label xml:lang="en">VWDI - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nfe4ddeea3c124510ac0d601ce93a8e57">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000002"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000491">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N535cbf83aede44febf910dc8ac71dab9">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000490"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">SCNC - AFIS Measurement</rdfs:label>
    <ns1:definition xml:lang="en">SCNC (Seed Coat Nep Count per Gram) is an AFIS measurement on the number of neps normalized per gram that are classified as seed coat neps</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000920">
    <ns1:definition xml:lang="en">Plant height (cm) in a field infested with Fusarium oxysporum f. sp. vasinfectum race 1 and root-knot nematodes.</ns1:definition>
    <rdfs:label xml:lang="en">PH - Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9b46708c396f41a09f75900571d7f0e0">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000853"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000837">
    <rdfs:label xml:lang="en">Fiber mature ratio</rdfs:label>
    <ns4:acronym xml:lang="en">FMR</ns4:acronym>
    <ns4:attribute>Maturity</ns4:attribute>
    <ns1:definition xml:lang="en">Using AFIS to measure the ratio of fibers with a 0.5 (or more) circularity divided by the amount of fibers with a 0.25 (or less) circularity. </ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000192">
    <ns4:acronym xml:lang="en">CRD</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns1:definition xml:lang="en">Colorimeter Rd, the percentage of reflectance</ns1:definition>
    <rdfs:label xml:lang="en">Reflectance</rdfs:label>
    <ns4:attribute>Reflectance</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000015">
    <ns4:attribute>Strength</ns4:attribute>
    <ns4:acronym xml:lang="en">FS</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <rdfs:label xml:lang="en">Fiber strength</rdfs:label>
    <ns1:definition xml:lang="en">The fiber strength of a bundle of fibers measured with the two jaws holding the fiber bundle separated by one-eighth inch, expressed in grams force per tex</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0001032">
