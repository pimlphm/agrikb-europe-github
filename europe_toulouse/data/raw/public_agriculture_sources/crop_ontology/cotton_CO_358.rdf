  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000984">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">The relative density of seed fuzz on the seed surface after ginning.  Seed fuzz code description: none=no seed fuzz on surface; medium=seed fuzz throughout surface; high=dense seed fuzz and seed coat is not visible; sparse=seed fuzz occurs sparingly on surface; tufted=fuzz only on micropylar end</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nae29d27b329641929cf3bbcdff6f092c">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
