        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0001086"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Standard method for cob tassel color. The anthocyanin coloration should be observed on the middle third of the uppermost cob, after the removal of some of the grains.</ns1:definition>
    <rdfs:label xml:lang="en">CobGlCol - Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000231">
    <ns1:definition xml:lang="en">Divide the total number of FmonSR damaged plants by the total number of plants harvested.</ns1:definition>
