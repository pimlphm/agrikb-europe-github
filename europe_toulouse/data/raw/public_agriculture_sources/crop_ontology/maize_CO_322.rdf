  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000189">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Number of days from sowing to when 50% of the plants shed pollen. Observe a known number of plants carefully (guideline: N = 20 for inbred lines or hybrids; N = 35 for open pollinated varieties) at the same time each day until 50% of the plants in the plot have produced at least one visible anther and score the number of days from sowing. Also, it can be calculated using sowing and anthesis date.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N40e0b007f8884f46b221ae6988187175">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000030"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Days to anthesis - Computation</rdfs:label>
  </ns2:Class>
