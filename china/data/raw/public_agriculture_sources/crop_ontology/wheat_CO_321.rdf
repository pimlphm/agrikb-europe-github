        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0001496"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculated from shoots sampled seven days after anthesis and SPI is expressed as a ratio and can be calculated as SPI= (dry weight of spikes at anthesis+7/dry weight of the whole plants (shoots) at anthesis+7).</ns1:definition>
  </ns2:Class>
