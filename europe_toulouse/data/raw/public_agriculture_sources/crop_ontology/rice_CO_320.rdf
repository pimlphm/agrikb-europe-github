        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000196"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Brown planthopper biotype 1 injury assessment</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001217">
    <ns1:definition xml:lang="en">Measure the width of the second elongated internode from the base at the wider portion of the stem with the leaf sheath. Repeat the measurement on other representative plant. Take the average diameter.</ns1:definition>
