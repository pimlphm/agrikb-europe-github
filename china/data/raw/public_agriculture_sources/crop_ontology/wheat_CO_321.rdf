  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000327">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N41cc81088b034b20a421a5bf043c11af">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000111"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Cereal cyst nematodes are more readily detected on seedlings than on adult plants. The roots of infested plants develop frequent branches and swellings (cysts).</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">HavenDmg Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000999">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N682c5ec06e264ec997260b76ee7db3b4">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000976"/>
