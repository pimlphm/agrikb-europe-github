    <ns4:attribute>Alveograph value P</ns4:attribute>
    <ns4:acronym xml:lang="en">AlvP</ns4:acronym>
    <ns1:definition xml:lang="en">P value is the force required to blow the bubble of dough. it is indicated by the maximum height of the curve.</ns1:definition>
    <ns4:entity>Dough</ns4:entity>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000314">
