    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Flag leaf angle estimation cult early</rdfs:label>
    <ns1:definition xml:lang="en">Cultivated species: at anthesis, estimate the angle of attachment between the flag leaf blade and the main panicle axis, near to the collar of the leaf. Record the average of five flag leaves</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001063">
