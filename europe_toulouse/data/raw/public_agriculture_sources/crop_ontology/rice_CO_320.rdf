    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:acronym xml:lang="en">CaryoLng</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001256">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Averaged Manual measurement - Unfilled spikelet number per panicle</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nd3beb3abf21b4cb288203bf994ed9cba">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001047"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count the number of unfilled spikelets per panicle of representative panicles and then take the average</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001375">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N829ecd55fa294486bb6b0ce114144600">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001242"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
