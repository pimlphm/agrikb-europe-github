  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000771">
    <rdfs:label xml:lang="en">Leaffolder unadjusted injury rating</rdfs:label>
    <ns1:definition xml:lang="en">In a greenhouse test where NT leaves have been scored using the single leaf injury score, calculate the injury rating R = (N1 + 2xN2 + 3xN3)x100% / (NTx3), where N1-N3 are the number of leaves with score 1-3</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
