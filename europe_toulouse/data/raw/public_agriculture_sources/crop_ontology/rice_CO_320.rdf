    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000777">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N7feeba5f68a242089d9344afe6338c74">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000027"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
