  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000214">
    <rdfs:label xml:lang="en">Rat damage</rdfs:label>
    <ns4:attribute>Damage</ns4:attribute>
    <ns4:acronym xml:lang="en">RatDam</ns4:acronym>
    <ns1:definition xml:lang="en">The extent of damage caused by rats. Symptoms: the tiller is cut at a 45 degrees angle. Damage is typically heavier in the center of a crop (stadium effect). A tiller cut through by a rodent is likely to regrow, if this is after maximum tillering then the regrown tiller is unlikely to produce panicles prior to harvest. Often the regrown, but non productive, tillers are not scored as rodent damage.</ns1:definition>
    <ns4:entity>Rat</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000537">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Sow plants in an enclosed cage or greenhouse with a uniform high population of biotype 1 of brown planthopper, and observe the damage on the seedlings</ns1:definition>
