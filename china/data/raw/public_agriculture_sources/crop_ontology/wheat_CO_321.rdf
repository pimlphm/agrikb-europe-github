    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1a9794967269459dad11a66f1effaa96">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000017"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">GN Computation</rdfs:label>
    <ns1:definition xml:lang="en">Grain number (GNO) as other yield components can be calculated or measured individually (Bell and Fischer, 1994, Reynolds et al., 2001, Pask et al., 2012), decide which method suit better for your objectives. GNO determines the sink size of the crop and under many conditions it is strongly correlated with yield. Grains/m2 (GNO) = yield (g/m2) / TGW (g) × 1000.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000655">
