  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000928">
    <rdfs:label xml:lang="en">awn color scale mature IRRI</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5340428912f34570b5ed94a18af7b0fb">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000525"/>
