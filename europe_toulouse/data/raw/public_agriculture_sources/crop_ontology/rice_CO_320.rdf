  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000110">
    <ns1:definition xml:lang="en">The length of the caryopsis, ie the seed with seed coat fused to pericarp, which is the structure that remains after dehulling (decorticating) the grain and before milling, commonly known as brown rice</ns1:definition>
    <ns4:attribute>Length</ns4:attribute>
    <rdfs:label xml:lang="en">Caryopsis length</rdfs:label>
