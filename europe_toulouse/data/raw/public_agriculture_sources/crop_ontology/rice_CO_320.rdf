    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Gently push tillers back and forth a few times, at a distance of 30 cm from the ground at intervals from harvest to maturity</ns1:definition>
    <rdfs:label xml:lang="en">Culm strength estimation - SES</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N40f976ff85374d6181b6b9aa42909316">
