        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">FLW50 - Estimantion</rdfs:label>
    <ns1:definition xml:lang="en">Duration in days between seed germination to 50% flowering</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000874">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5033688950134c1f8053098d0cb26d7c">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000839"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">FWDS - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Disease severty index of vascular root stain in a field infested with Fusarium oxysporum f. sp. vasinfectum race 4.  Vascular Root Staining: 0 = no vascular root staining evident, 1 = light vascular root staining evident as spotty areas, 2 = more continuous than 1, but light colored staining  covering an area between one quarter and one half of the stem cross-section, 3 = moderate brown/black staining evident in a band encircling most of the stem cross section, 4 = brown/black staining evident across most vascular tissue in stem cross section, and 5 = plant severely damaged or plant death with staining evident throughout a cross-section of root tissue</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0001020">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N30db26c007b54e16951ba4c32064a116">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000930"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">1-3 low-high bract teeth number scale</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000050">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
