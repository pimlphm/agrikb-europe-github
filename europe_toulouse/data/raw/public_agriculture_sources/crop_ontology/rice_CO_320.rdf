  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000244">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ndef6b7eba72f4ffea00e11d6936a8c45">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000106"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Gel consistency lab measurement</rdfs:label>
    <ns1:definition xml:lang="en">Place 0.1g ground rice in a test tube with thymol blue (0.025% in ethanol, 0.2 ml) and KOH (0.2N, 2 ml). Shake the tube to mix contents, boil (8 min), rest (5 min) and then place in an ice-bath (15 min). Lay cooled tubes flat on graph paper for 1 hour, and then measure the distance that the gel travels . Included standards, as the age of the rice, degree of milling and operator skill affect reproducibility: IR48 (85?90 mm), IR32 (72-75 mm) and IR42 (30-32 mm).</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na979fc0e52cc41e0bd50dc60648d1b01">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000106"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000264">
    <ns1:definition xml:lang="en">Cultivated species: visually estimate the colour of ligules at late vegetative stage before flowering.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
