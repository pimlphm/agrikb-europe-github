  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000196">
    <rdfs:label xml:lang="en">Brown planthopper damage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
