  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001075">
    <rdfs:label xml:lang="en">Flag leaf area</rdfs:label>
    <ns4:entity>Flag leaf</ns4:entity>
    <ns4:acronym xml:lang="en">FLA</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns4:attribute>Area</ns4:attribute>
    <ns1:definition xml:lang="en">Area of the uppermost leaf on the main culm</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000505">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <rdfs:label xml:lang="en">Lemma and palea color ornementation</rdfs:label>
    <ns4:acronym xml:lang="en">LmPColOrn</ns4:acronym>
    <ns1:definition xml:lang="en">Colour ornamentation of the lemma and palea. It characterizes the colours present only on parts of the lemma and palea</ns1:definition>
    <ns4:entity>Lemma and palea</ns4:entity>
    <ns4:attribute>Colour ornementation</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000486">
    <rdfs:label xml:lang="en">Apiculus shape</rdfs:label>
    <ns4:entity>Apiculus of lemma</ns4:entity>
    <ns1:definition xml:lang="en">Shape of the apiculus of the lemma</ns1:definition>
    <ns4:attribute>Shape</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns4:acronym xml:lang="en">ApSh</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000543">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2897cafc88bc4dec89a01a9e104c0e61">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000117"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5d18568432274b1691295302d0836cb2">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000117"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Caryopsis width measurement</rdfs:label>
    <ns1:definition xml:lang="en">Use calliper, photo-enlarger or scale images to measure the width of ten caryopses at their widest point at right angles to its length and calculate their average</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001220">
    <rdfs:label xml:lang="en">Weighing - filled grain weight</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Take random sample of a given number of filled grains, oven-dry until constant weight and weigh.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1e465479a0fc44918caa25b7ca6f32c9">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001048"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001281">
    <rdfs:label xml:lang="en">Calculation - Grain yield from plant density</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N8b59ccb6941f4c99b6ca80065bb805f4">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000073"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Take yield per plant and multiply with plants density</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000513">
    <ns4:acronym xml:lang="en">PanBrArr</ns4:acronym>
    <ns4:entity>Panicle branch</ns4:entity>
    <ns4:attribute>Arrangement</ns4:attribute>
