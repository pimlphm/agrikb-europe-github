    <rdfs:label xml:lang="en">Outcrossing calculation</rdfs:label>
    <ns1:definition xml:lang="en">Grow the male sterile line in the field, ensuring an abundant supply of pollen from other plants while it is flowering. Calculate the proportion of seed set on the out-pollinated primary panicles</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nbfa877aeabaa4550994f3a1c1a72ac79">
