  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000509">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <rdfs:label xml:lang="en">Panicle basal branch number</rdfs:label>
    <ns4:entity>Panicle basal branch</ns4:entity>
    <ns4:acronym xml:lang="en">PanN</ns4:acronym>
    <ns1:definition xml:lang="en">Number of primary branches on the basal whorl of the panicle</ns1:definition>
    <ns4:attribute>Number</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000520">
    <ns1:definition xml:lang="en">Examine the intensity of any purple colour attributable to anthocyanin on the apiculus of immature lemmas</ns1:definition>
    <rdfs:label xml:lang="en">Immature apiculus anthocyanin examination</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na41cae4932684614b86f8287ca342b75">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000896"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
