  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000043">
    <rdfs:label xml:lang="en">Seed oil content</rdfs:label>
    <ns4:attribute>Oil content</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns4:acronym xml:lang="en">SOC</ns4:acronym>
    <ns1:definition xml:lang="en">Percentage of oil by weight in 10 gram sample of dehulled seeds</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000991">
    <rdfs:label xml:lang="en">VWDS - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N7a5c668b3231491f973123fc5b0b3867">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000001"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Verticillium wilt disease severity (or disease infection index) was calculated according to the formula: DI=[Ʃ(Ni × i)/(N × i)] × 100, Where i is the maximum disease grade, Ni, the number of plants with corresponding disease grade and N the number of total investigated plants</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000051">
    <rdfs:label xml:lang="en">Trichome density on stem</rdfs:label>
    <ns4:acronym xml:lang="en">DTS</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns1:definition xml:lang="en">The degree or relative density of trichome on stem</ns1:definition>
    <ns4:attribute>Trichome density</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000562">
    <rdfs:label xml:lang="en">BCONC - Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Standard method for the total Boron (B) concentration measured in a given volume of stem extract</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6e534e156c744434a1d2bed0f31d5516">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
