    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000106">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:entity>Gel</ns4:entity>
    <ns4:attribute>Consistency</ns4:attribute>
    <ns1:definition xml:lang="en">Describes the consistency of a rice gel formed by grinding, chemically treating, boiling, and cooling a sample of grains. This measures the tendency of cooked rice to harden on cooling, a function of carbohydrate composition</ns1:definition>
    <ns4:acronym xml:lang="en">GelC</ns4:acronym>
    <rdfs:label xml:lang="en">Gel consistency</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001106">
    <rdfs:label xml:lang="en">Stem minor diameter - 2nd internode</rdfs:label>
    <ns4:attribute>Minor diameter</ns4:attribute>
    <ns4:acronym xml:lang="en">SDMin</ns4:acronym>
    <ns1:definition xml:lang="en">Minor diameter (ie the shortest diameter of an eliptical section) of the narrower portion of the second elongated internode from the base with the leaf sheath</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns4:entity>2nd elongated stem internode</ns4:entity>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000183">
    <ns4:entity>Ragged stunt</ns4:entity>
    <ns4:acronym xml:lang="en">RaggedStuntSev</ns4:acronym>
    <rdfs:label xml:lang="en">Ragged stunt disease</rdfs:label>
    <ns4:attribute>Severity</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns1:definition xml:lang="en">The type and severity of ragged stunt symptoms caused by rice ragged stunt virus (RRSV). Symptoms: plants are stunted but remain dark green. Leaves are ragged and twisted. Vein swelling on leaf collar, leaf blades and leaf sheaths</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001181">
    <rdfs:label xml:lang="en">Calculation - Flag leaf area</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N3800f69ca82a421aac9de241bc7428cb">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001075"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculate as length times the width of the uppermost leaf on the main culm, multiplied by a constant (0.725)</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000366">
    <rdfs:label xml:lang="en">Stem rot incidence estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N432ea72865b74e1ea39d92da9b98b623">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000186"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Estimate the propotion of tillers that are infected</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001055">
