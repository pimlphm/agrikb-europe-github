    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf028c25cf8b242bcaad2cda9f31b3cc6">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000011"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Laboratory seed test for germination should be carried out before seeding to calculate seeding rates or determine the status of storage seed. The percentage of seeds capable of producing normal seedlings under ordinarily favorable conditions (not including seeds which produce weak, malformed, or obviously abnormal sprouts), determined by methods ISTA seed testing protocols.</ns1:definition>
    <rdfs:label xml:lang="en">Germ Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
  <ns2:ObjectProperty rdf:about="https://cropontology.org/rdf/scale_of">
    <rdfs:label>scale_of</rdfs:label>
  </ns2:ObjectProperty>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001547">
    <rdfs:label xml:lang="en">SpkPI Computation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne683635d8c92415eb49eb7c467c6fc89">
